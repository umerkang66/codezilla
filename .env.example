# Admin Email Accounts (Comma-separated for role assignment: 'admin@example.com' or 'admin1@example.com,admin2@example.com')
ADMIN="codzilla.company@gmail.com,your_admin_email@example.com"

# Database Credentials
DB_PASSWORD="your_database_password_here"

# Public Supabase Credentials (Client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# Supabase Server Credentials (Server-side)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
SUPABASE_SECRET_KEY="your_supabase_secret_key_here"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"
